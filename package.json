{
  "name": "signflow",
  "private": true,
  "version": "0.0.0",
  "description": "Draw naturally. Animate beautifully. Export anywhere.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @signflow/web",
    "build": "npm run build -w @signflow/web",
